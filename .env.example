# Copia este fichero a .env y rellena los valores.
# No pongas secretos reales en el repo.

# Postgres (obligatorio)
# En local con Docker: docker run ... -p 5433:5432 pgvector/pgvector:pg16
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5433/gestor_obra

# --- OCR / LLM cloud (recomendado: no hace falta instalar Tesseract en el SO) ---
# Requiere autorización de ai.seguridad@exafan.com y cláusula [NO-ENTRENAR].
# Prioridad: OCR_API_* → si no, LLM visión (LLM_API_*).

# LLM (extracción de presupuesto + visión OCR de escaneos).
# Claude: pega la clave y deja la base vacía.
# PDF → markdown: Sonnet. Extracción de ese markdown: Haiku (menos tokens).
# Otro proveedor compatible: LLM_PROVEEDOR=openai y LLM_API_BASE=.../v1
LLM_API_KEY=
LLM_API_BASE=
LLM_PROVEEDOR=
LLM_MODEL=
LLM_MODELO_TRANSCRIPCION=
LLM_MODELO_EXTRACCION=
LLM_VISION_MODEL=gpt-4o-mini

# OCR cloud dedicado (opcional). OCR_API_BASE = URL completa del endpoint.
# POST JSON: {"image_base64":"…","mime_type":"image/png","language":"spa"} → {"text":"…"}
OCR_API_KEY=
OCR_API_BASE=
